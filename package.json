{
  "name": "pharm-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "check:export": "node scripts/check-static-export.mjs",
    "assets:pwa": "node scripts/generate-pharmaideia-brand.mjs && node scripts/generate-pharmaideia-avatars.mjs",
    "check:pwa": "tsc -p student-pwa/tsconfig.json && tsc -p student-pwa/tsconfig.sw.json && tsc -p developer-tools/tsconfig.json && node scripts/check-student-pwa.mjs",
    "preview:pwa": "node scripts/preview-student-pwa.mjs",
    "test:pwa:browser": "node scripts/student-pwa-browser-smoke.mjs",
    "test:website:browser": "node scripts/website-platform-regression.mjs",
    "check:secrets": "node scripts/check-platform-secrets.mjs",
    "review:pwa:planner": "node scripts/record-student-planner.mjs",
    "review:m3:logos": "node scripts/generate-pharmaideia-logo-review.mjs",
    "review:m3:design": "node scripts/capture-pharmaideia-design-review.mjs",
    "preview:developer": "node scripts/preview-developer-workbench.mjs",
    "test:developer:browser": "node scripts/developer-workbench-browser-smoke.mjs",
    "review:m3:identity": "node scripts/refine-pharmaideia-identity.mjs",
    "review:nexus": "node scripts/review-knowledge-nexus.mjs && node scripts/capture-knowledge-nexus.mjs && node scripts/check-knowledge-nexus.mjs",
    "check:nexus": "node scripts/check-knowledge-nexus.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
